# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev scratch
scratch/
.vscode/
.claude

# agent run output — one folder per agent per run, regenerated every time.
# .agents/skills/ is deliberately kept: it holds real, reusable skill scripts.
# The rule ignores the *contents* of .agents rather than the directory itself,
# because git will not descend into an excluded directory to re-include a path.
.agents/*
!.agents/skills/
