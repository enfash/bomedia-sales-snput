GOOGLE_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID=
GEMINI_API_KEY=your_gemini_api_key_here

# Admin portal login credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# HMAC key used to sign session cookies. Required in production — the app
# refuses to issue tokens without it rather than falling back to a default.
# Keep this DIFFERENT from ADMIN_PASSWORD: sharing one value means changing
# the login password silently signs every user out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
