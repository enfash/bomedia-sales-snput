GOOGLE_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID=
GEMINI_API_KEY=your_gemini_api_key_here

# Admin portal login credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# HMAC key used to sign session cookies. Required in production — the app
# refuses to issue tokens without it rather than falling back to a default.
# Keep this DIFFERENT from ADMIN_PASSWORD: sharing one value means changing
# the login password silently signs every user out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase migration tools. No application route uses these yet.
# Keep actual URLs/passwords in .env.local; never use NEXT_PUBLIC_ for them.
# Dedicated runtime role via transaction pooler (configured in a later phase).
SUPABASE_DATABASE_URL=
# Migration owner via direct connection or IPv4 session pooler; before live cutover.
SUPABASE_MIGRATION_DATABASE_URL=
# Project reference (20 characters) required by the migration tools.
SUPABASE_MIGRATION_PROJECT_REF=
# Optional path to the project's downloaded CA certificate for verified TLS.
SUPABASE_CA_CERT_PATH=
# Random passphrase of at least 32 characters; also save in your password manager.
# Encrypts/decrypts the local original-workbook archive only.
MIGRATION_ARCHIVE_PASSPHRASE=

# Staged staff authentication. Keep sheets until PostgreSQL login checks pass.
AUTH_BACKEND=sheets
# Separate least-privilege auth server login, never postgres/migration owner.
SUPABASE_AUTH_DATABASE_URL=
SUPABASE_PROJECT_REF=
# For hosted/serverless environments where the local CA file is unavailable.
SUPABASE_CA_CERT_PEM=

# New accounting endpoints remain disabled until final imports/opening books.
POSTGRES_FINANCIAL_API_ENABLED=false
SUPABASE_FINANCIAL_DATABASE_URL=
# Bind the verified configured admin to their own enabled staff identity.
SUPABASE_ADMIN_STAFF_ID=
